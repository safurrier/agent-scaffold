+#!/usr/bin/env -S uv run python
+# MISE description="Validate contract declarations and decision promotion for the active slice"
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
+from lib import PROJECT_ROOT, log_error, log_ok, log_step  # noqa: E402
+from plan_contract import (  # noqa: E402
+    adr_dir,
+    current_plan_context,
+    file_has_meaningful_content,
+    extract_paths_from_bullets,
+    ledger_path,
+    plan_reference_present,
+    section_has_meaningful_bullets,
+)
+
+log_step("Checking spec and decision contract")
+
+current = current_plan_context(PROJECT_ROOT)
+if current is None:
+    log_ok("No active plan to spec-check")
+    sys.exit(0)
+
+decisions_file = current.path / "DECISIONS.md"
+if not file_has_meaningful_content(decisions_file):
+    log_error("DECISIONS.md needs a real change summary before handoff.")
+    sys.exit(1)
+
+for heading in ("What Changed", "Why"):
+    if not section_has_meaningful_bullets(decisions_file, heading):
+        log_error(f"DECISIONS.md is missing a meaningful '{heading}' section.")
+        sys.exit(1)
+
+if current.meta.contract_change in {"docs_only", "contract_changed"}:
+    reflected_paths = extract_paths_from_bullets(decisions_file, "Where Reflected")
+    if not reflected_paths:
+        log_error(
+            "Docs or contract changes must list durable reflected paths in DECISIONS.md."
+        )
+        sys.exit(1)
+    for raw_path in reflected_paths:
+        target = PROJECT_ROOT / Path(raw_path)
+        if not target.exists():
+            log_error(f"Reflected path does not exist: {raw_path}")
+            sys.exit(1)
+
+if current.meta.decision_record == "ledger":
+    active_ledger = ledger_path(PROJECT_ROOT)
+    if not active_ledger.exists():
+        log_error("Decision ledger is missing.")
+        sys.exit(1)
+    if not plan_reference_present(active_ledger, current.path.name, current.meta.slug):
+        log_error(
+            "Decision ledger must contain an entry referencing the active plan before sync-check passes."
+        )
+        sys.exit(1)
+
+if current.meta.decision_record == "adr":
+    decisions_dir = adr_dir(PROJECT_ROOT)
+    adr_files = sorted(decisions_dir.glob("*.md")) if decisions_dir.exists() else []
+    if not adr_files:
+        log_error("decision_record=adr requires an ADR under docs/explanation/decisions/.")
+        sys.exit(1)
+    if not any(
+        plan_reference_present(path, current.path.name, current.meta.slug)
+        for path in adr_files
+    ):
+        log_error(
+            "No ADR references the active plan. Add or update an ADR before handoff."
+        )
+        sys.exit(1)
+
+log_ok(f"Spec contract ready: {current.path.relative_to(PROJECT_ROOT)}")
