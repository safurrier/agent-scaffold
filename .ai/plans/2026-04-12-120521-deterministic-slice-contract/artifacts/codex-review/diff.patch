+#!/usr/bin/env -S uv run python
+# MISE description="Validate the active plan and its required slice artifacts"
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
+from lib import PROJECT_ROOT, log_error, log_ok, log_step  # noqa: E402
+from plan_contract import (  # noqa: E402
+    checklist_has_meaningful_items,
+    current_plan_context,
+    file_has_meaningful_content,
+    git_changed_paths,
+    git_current_branch,
+    in_progress_plan_contexts,
+    missing_required_plan_files,
+    strip_plan_local_changes,
+    validate_meta_yaml,
+)
+
+log_step("Checking plan contract")
+
+in_progress = in_progress_plan_contexts(PROJECT_ROOT)
+if len(in_progress) > 1:
+    log_error("Multiple plans are marked in-progress. Keep exactly one active slice.")
+    for ctx in in_progress:
+        print(f"  - {ctx.path.relative_to(PROJECT_ROOT)}", file=sys.stderr)
+    sys.exit(1)
+
+current = current_plan_context(PROJECT_ROOT)
+changed_paths = git_changed_paths(PROJECT_ROOT)
+meaningful_changes = strip_plan_local_changes(changed_paths, current.path if current else None)
+
+if current is None:
+    if meaningful_changes:
+        log_error("Meaningful changes exist, but no active plan was found.")
+        for path in meaningful_changes:
+            print(f"  - {path}", file=sys.stderr)
+        sys.exit(1)
+    log_ok("No active plan and no meaningful changes")
+    sys.exit(0)
+
+missing = missing_required_plan_files(current.path)
+if missing:
+    log_error("Active plan is missing required files:")
+    for rel in missing:
+        print(f"  - {rel}", file=sys.stderr)
+    sys.exit(1)
+
+errors = validate_meta_yaml(current.meta)
+if errors:
+    log_error("META.yaml is incomplete:")
+    for error in errors:
+        print(f"  - {error}", file=sys.stderr)
+    sys.exit(1)
+
+branch = git_current_branch(PROJECT_ROOT)
+if branch and current.meta.branch and current.meta.branch != branch:
+    log_error(
+        f"Plan branch '{current.meta.branch}' does not match current branch '{branch}'."
+    )
+    sys.exit(1)
+
+if not checklist_has_meaningful_items(current.path / "TODO.md"):
+    log_error("TODO.md must contain at least one meaningful checklist item.")
+    sys.exit(1)
+
+if meaningful_changes and current.meta.status != "in-progress":
+    log_error("Meaningful changes require the active plan status to be 'in-progress'.")
+    sys.exit(1)
+
+if current.meta.status == "in-progress" and not file_has_meaningful_content(
+    current.path / "LEARNING_LOG.md"
+):
+    log_error("LEARNING_LOG.md should record at least one in-progress note once work starts.")
+    sys.exit(1)
+
+log_ok(f"Plan contract ready: {current.path.relative_to(PROJECT_ROOT)}")
