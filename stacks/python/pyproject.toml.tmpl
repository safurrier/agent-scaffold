[project]
name = "{{project_name}}"
version = "0.1.0"
description = "{{project_description}}"
license = "MIT"
requires-python = ">=3.12"
{% if author_name and author_email %}
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
{% elif author_name %}
authors = [{ name = "{{ author_name }}" }]
{% elif author_email %}
authors = [{ email = "{{ author_email }}" }]
{% endif %}
dependencies = []

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "ruff>=0.11",
    "ty>=0.0.19",
    "pytest-xdist>=3.6",
    "pre-commit>=4.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{module_name}}"]

# ── Ruff ─────────────────────────────────────
[tool.ruff]
target-version = "py312"
line-length = 88
extend-exclude = [".agent/skills/"]

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # pyflakes
    "I",    # isort
    "B",    # flake8-bugbear
    "C4",   # flake8-comprehensions
    "UP",   # pyupgrade
    "N",    # pep8-naming
    "S",    # flake8-bandit
    "PTH",  # flake8-use-pathlib
    "RUF",  # ruff-specific rules
]
ignore = [
    "E501",  # line too long (formatter handles this)
    "S101",  # assert usage (needed in tests)
]

[tool.ruff.lint.isort]
known-first-party = ["{{module_name}}"]

# ── ty ───────────────────────────────────────
[tool.ty.environment]
python-version = "3.12"

[tool.ty.src]
exclude = [".agent/skills/**"]

# ── Pytest ───────────────────────────────────
[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-n auto --dist=loadfile --cov={{module_name}} --cov-report=term-missing --junit-xml=test-results/junit.xml -q"
