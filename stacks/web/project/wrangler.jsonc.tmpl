{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{project_name}}",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "{{project_name}}",
      "database_id": "local-development",
    },
  ],
}
