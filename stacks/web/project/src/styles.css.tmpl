{% if web_ui_tailwind %}@import "tailwindcss";

@layer base {
  :root {
    color: #1f2937;
    background: #f8fafc;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  body {
    margin: 0;
  }
}

@layer components {
  .app-shell {
    @apply mx-auto grid max-w-5xl gap-6 px-6 py-12;
  }

  .hero,
  .panel {
    @apply rounded-lg border border-slate-300 bg-white p-6 shadow-sm;
  }

  .eyebrow {
    @apply mb-2 text-xs font-bold uppercase text-teal-700;
  }

  .summary {
    @apply mb-0 text-slate-600;
  }

  code {
    @apply inline-block rounded-md bg-indigo-50 px-2.5 py-2;
  }
}
{% else %}:root {
  color: #1f2937;
  background: #f8fafc;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body {
  margin: 0;
}

.app-shell {
  display: grid;
  gap: 24px;
  margin: 0 auto;
  max-width: 960px;
  padding: 48px 24px;
}

.hero,
.panel {
  background: #ffffff;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  padding: 24px;
}

.eyebrow {
  color: #0f766e;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0;
  margin: 0 0 8px;
  text-transform: uppercase;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  font-size: 2rem;
  line-height: 1.1;
}

.summary {
  color: #4b5563;
  margin-bottom: 0;
}

code {
  background: #eef2ff;
  border-radius: 6px;
  display: inline-block;
  padding: 8px 10px;
}
{% endif %}